# Variáveis do servidor (Vercel). Nunca coloque valores reais neste arquivo.
# Guia: docs/publicar-na-vercel.md
SHEET_ID_DB=                  # trecho da URL da planilha NOVA7 | SITE | BANCO DE DADOS entre /d/ e /edit
GOOGLE_SERVICE_ACCOUNT_JSON=  # arquivo JSON da conta de serviço, convertido para base64 (uma linha)
GOOGLE_CLIENT_ID=             # ID do cliente OAuth (Login com Google); termina em .apps.googleusercontent.com
SESSION_SECRET=               # texto longo e aleatório (openssl rand -hex 32)
# SESSION_TTL_SECONDS=43200   # opcional: duração da sessão (padrão 12 horas)

# Só no seu computador (npm run dev). NÃO defina na Vercel.
# AUTH_DEV_EMAIL=dev@local

# Senha padrão do primeiro acesso: quem ainda não criou a própria senha entra com ela e é obrigado a trocar.
SENHA_PADRAO=

# Postgres (Neon, Supabase, Railway... qualquer um): opcional. Guia: docs/banco-postgres-passo-a-passo.md
# DATABASE_URL=               # URL de conexão do Postgres (de preferência a "pooled"). Na Vercel, marque como Sensitive
# DB_BACKEND=sheets           # troque para pg só depois de copiar e conferir os dados (Configurações > Fontes de dados > Banco de dados)

# Chave do computador da agência que lê PDFs de vendas e estoques para a Central de Promoções (PowerShell: scripts/analise-local/Agente.ps1).
# Texto longo e aleatório (24 caracteres ou mais). Na Vercel, marque como Sensitive. Sem ela, o site lê os arquivos no navegador.
# LEITURA_TOKEN=
